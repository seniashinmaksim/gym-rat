{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymrat.local/schema/workout-import.v1.schema.json",
  "title": "Gym Rat workout import (gymrat.workout v1.x)",
  "description": "Mirrors the zod schema in src/domain/importer.ts. Accepts an envelope {schema, schema_version, workouts[]}, a single bare workout object, or an array of workout objects. All objects are strict (no unknown keys). Unknown values must be null or omitted — never invented.",
  "oneOf": [
    { "$ref": "#/$defs/Envelope" },
    { "$ref": "#/$defs/Workout" },
    { "type": "array", "items": { "$ref": "#/$defs/Workout" }, "minItems": 1 }
  ],
  "$defs": {
    "Confidence": { "type": "string", "enum": ["confirmed", "probable", "uncertain", "unknown"] },
    "Time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "description": "HH:mm, 24-hour" },
    "Rom": { "type": "string", "enum": ["full", "lengthened_partial", "partial"] },
    "MuscleId": {
      "type": "string",
      "enum": ["chest", "upper_chest", "lower_chest", "lats", "upper_back", "traps", "front_delts", "side_delts", "rear_delts", "biceps", "triceps", "forearms", "quads", "hamstrings", "glutes", "calves", "abs", "spinal_erectors", "adductors"]
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workouts"],
      "properties": {
        "schema": { "const": "gymrat.workout" },
        "schema_version": {
          "type": ["string", "number"],
          "description": "Must start with '1' (e.g. \"1.0\"). Other major versions are rejected."
        },
        "workouts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Workout" } }
      }
    },
    "Workout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "exercises"],
      "properties": {
        "client_ref": { "type": "string", "maxLength": 120, "description": "Stable unique id for this report; used to block duplicate imports." },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Local calendar date YYYY-MM-DD in the training timezone." },
        "start_time": { "anyOf": [{ "$ref": "#/$defs/Time" }, { "type": "null" }] },
        "end_time": { "anyOf": [{ "$ref": "#/$defs/Time" }, { "type": "null" }] },
        "duration_min": { "type": ["number", "null"], "minimum": 0, "maximum": 600 },
        "location_id": { "type": ["string", "null"], "maxLength": 80, "description": "Shorthand for location.location_id." },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "location_id": { "type": ["string", "null"], "maxLength": 80 },
            "name_hint": { "type": ["string", "null"], "maxLength": 200 },
            "confidence": { "$ref": "#/$defs/Confidence" }
          }
        },
        "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Exercise" } },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fatigue_1_5": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
            "energy_1_5": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
            "sleep_hours": { "type": ["number", "null"], "minimum": 0, "maximum": 24 },
            "session_rpe": { "type": ["number", "null"], "minimum": 1, "maximum": 10 },
            "soreness": {
              "type": "object",
              "description": "Muscle id → soreness 0 (none) .. 4 (severe).",
              "propertyNames": { "$ref": "#/$defs/MuscleId" },
              "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4 }
            },
            "notes": { "type": "string", "maxLength": 2000 }
          }
        },
        "notes": { "type": "string", "maxLength": 4000 },
        "raw_input": { "type": "string", "maxLength": 20000, "description": "Original message. Stored only inside encrypted app storage." },
        "uncertainties": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "Exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sets"],
      "anyOf": [
        { "required": ["exercise_id"], "properties": { "exercise_id": { "type": "string", "minLength": 1 } } },
        { "required": ["exercise_name_raw"], "properties": { "exercise_name_raw": { "type": "string", "minLength": 1 } } }
      ],
      "properties": {
        "exercise_id": { "type": ["string", "null"], "maxLength": 80, "description": "Id from the exercise library (src/data/exercises.ts) or a custom exercise." },
        "exercise_name_raw": { "type": ["string", "null"], "maxLength": 200, "description": "Name exactly as the user wrote it." },
        "exercise_confidence": { "$ref": "#/$defs/Confidence" },
        "equipment_id": { "type": ["string", "null"], "maxLength": 80, "description": "Shorthand for equipment.equipment_id." },
        "equipment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "equipment_id": { "type": ["string", "null"], "maxLength": 80 },
            "name_hint": { "type": ["string", "null"], "maxLength": 200 },
            "manufacturer": { "type": ["string", "null"], "maxLength": 100 },
            "model": { "type": ["string", "null"], "maxLength": 100 },
            "kind": {
              "type": ["string", "null"],
              "enum": ["machine", "plate_loaded", "cable", "smith", "barbell", "dumbbell", "kettlebell", "bodyweight", "band", "other", null]
            },
            "confidence": { "$ref": "#/$defs/Confidence" }
          }
        },
        "variation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bench_angle_deg": { "type": ["number", "null"], "minimum": -45, "maximum": 90 },
            "grip": { "type": ["string", "null"], "maxLength": 40 },
            "grip_width": { "type": ["string", "null"], "maxLength": 40 },
            "stance": { "type": ["string", "null"], "maxLength": 60 },
            "rom": { "anyOf": [{ "$ref": "#/$defs/Rom" }, { "type": "null" }] },
            "unilateral": { "type": ["boolean", "null"] },
            "notes": { "type": ["string", "null"], "maxLength": 500 }
          }
        },
        "settings": {
          "type": "object",
          "description": "Machine settings used this session, e.g. {\"seat\": 4}. Values are stored as strings.",
          "additionalProperties": { "type": ["string", "number"] }
        },
        "rest_between_sets_sec": { "type": ["number", "null"], "minimum": 0, "maximum": 3600, "description": "Applied to every set after the first that has no rest_before_sec." },
        "rest_after_sec": { "type": ["number", "null"], "minimum": 0, "maximum": 7200 },
        "notes": { "type": "string", "maxLength": 1000 },
        "sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Set" } }
      }
    },
    "Set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight_kg", "reps"],
      "properties": {
        "type": { "type": "string", "enum": ["warmup", "working", "drop"], "default": "working" },
        "weight_kg": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Load as shown on THIS equipment. Dumbbells: weight of ONE dumbbell. Plate-loaded with load_mode per_side: plates on one side. null = unknown."
        },
        "load_mode": { "type": "string", "enum": ["total", "per_side", "bodyweight_plus", "assisted"], "default": "total" },
        "reps": { "type": ["integer", "null"], "minimum": 0, "maximum": 200 },
        "rir": { "type": ["number", "null"], "minimum": 0, "maximum": 10, "description": "Reps in reserve for THIS set only. Omit/null if not stated." },
        "rir_source": { "type": "string", "enum": ["reported", "inferred", "unknown"], "description": "Defaults to 'reported' when rir is present, else 'unknown'." },
        "to_failure": { "type": "boolean" },
        "rest_before_sec": { "type": ["number", "null"], "minimum": 0, "maximum": 3600 },
        "rom": { "$ref": "#/$defs/Rom" },
        "technique_ok": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Expands into N identical sets. Use only when the sets were truly identical (same load, reps and RIR)." },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
